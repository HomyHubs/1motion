{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editorial explainer project v1",
  "type": "object",
  "required": [
    "version",
    "title",
    "mode",
    "format",
    "approvals",
    "sources",
    "claims",
    "assets",
    "beats"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "script_only",
        "pilot",
        "full"
      ]
    },
    "format": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "approvals": {
      "type": "object",
      "required": [
        "story",
        "pilot"
      ],
      "properties": {
        "story": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "pilot": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "rights_note": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "type",
          "status",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "type": {
            "enum": [
              "fact",
              "attributed",
              "allegation",
              "analysis",
              "forecast"
            ]
          },
          "status": {
            "enum": [
              "verified",
              "pending",
              "illustrative"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "status",
          "rights_note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "waiting",
              "placeholder"
            ]
          },
          "rights_note": {
            "type": "string"
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "narration",
          "purpose",
          "scene_type",
          "claim_ids",
          "asset_ids",
          "audio_path",
          "clip_path",
          "tail_s",
          "layers",
          "events"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "narration": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "scene_type": {
            "enum": [
              "map_route",
              "data_compare",
              "source_card",
              "stat_callout",
              "cashflow",
              "transaction_flow",
              "obligation_timeline",
              "document_desk",
              "asset_grid",
              "footage_overlay"
            ]
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "audio_path": {
            "type": "string"
          },
          "clip_path": {
            "type": "string"
          },
          "tail_s": {
            "type": "number",
            "minimum": 0
          },
          "audio_duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "slot_duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "role"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target",
                "trigger_phrase",
                "action",
                "meaning"
              ],
              "properties": {
                "target": {
                  "type": "string"
                },
                "trigger_phrase": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "meaning": {
                  "type": "string"
                },
                "time_s": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}

# Biến môi trường cho make-editorial-explainer (doctor đọc). Sao chép sang ~/.hermes/.env hoặc profile shell, thay giá trị thật của máy.
VIENEU_PYTHON=<đường dẫn python của venv VieNeu>
VIENEU_VOICE=<tên giọng; bỏ trống để dùng mặc định>
HYPERFRAMES_CMD=<lệnh hyperframes nếu không nằm trên PATH>

# Hồ sơ VM cũ, anh báo, chưa xác minh:
# 2 vCPU AMD EPYC 9D25, RAM khoảng 7.7 GB, không GPU
# VIENEU_PYTHON=~/.venvs/vieneu/bin/python
# wrapper: ~/workspace/tts-vi/tts-vi.sh "text" out.wav
# script: ~/workspace/tts-vi/vieneu/synth.py
# cache model khoảng 540 MB theo log người dùng
